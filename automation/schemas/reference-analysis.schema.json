{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reference image analysis (general characteristics only)",
  "type": "object",
  "required": [
    "reference_summaries",
    "illustration_category",
    "line_weight",
    "line_smoothness",
    "level_of_detail",
    "shape_language",
    "character_proportions",
    "facial_simplicity",
    "composition_density",
    "whitespace",
    "background_complexity",
    "typography",
    "orientation_layout",
    "perspective",
    "colour_behaviour",
    "palette_characteristics",
    "contrast",
    "shading_approach",
    "texture",
    "emotional_tone",
    "apparent_audience",
    "printable_suitability",
    "do_not_copy",
    "analysed_at",
    "model",
    "reference_files"
  ],
  "properties": {
    "reference_summaries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "reference_file",
          "summary"
        ],
        "properties": {
          "reference_file": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "illustration_category": {
      "type": "string",
      "minLength": 1
    },
    "line_weight": {
      "type": "string",
      "minLength": 1
    },
    "line_smoothness": {
      "type": "string",
      "minLength": 1
    },
    "level_of_detail": {
      "type": "string",
      "minLength": 1
    },
    "shape_language": {
      "type": "string",
      "minLength": 1
    },
    "character_proportions": {
      "type": "string",
      "minLength": 1,
      "description": "Proportions of any characters, or \"not applicable\" if there are none"
    },
    "facial_simplicity": {
      "type": "string",
      "minLength": 1,
      "description": "How faces are drawn, or \"not applicable\" if there are none"
    },
    "composition_density": {
      "type": "string",
      "minLength": 1
    },
    "whitespace": {
      "type": "string",
      "minLength": 1
    },
    "background_complexity": {
      "type": "string",
      "minLength": 1,
      "description": "Background treatment: white, flat colour, texture, illustrated scene, full bleed, and how busy it is"
    },
    "typography": {
      "type": "string",
      "minLength": 1,
      "description": "Lettering behaviour where visible (style, weight, placement, how much text), or \"no visible text\""
    },
    "orientation_layout": {
      "type": "string",
      "minLength": 1,
      "description": "Apparent orientation and layout structure, e.g. landscape card front with centred focal subject"
    },
    "perspective": {
      "type": "string",
      "minLength": 1
    },
    "colour_behaviour": {
      "type": "string",
      "minLength": 1
    },
    "palette_characteristics": {
      "type": "string",
      "minLength": 1
    },
    "contrast": {
      "type": "string",
      "minLength": 1
    },
    "shading_approach": {
      "type": "string",
      "minLength": 1
    },
    "texture": {
      "type": "string",
      "minLength": 1
    },
    "emotional_tone": {
      "type": "string",
      "minLength": 1
    },
    "apparent_audience": {
      "type": "string",
      "minLength": 1,
      "description": "Audience the references appear to target, only as far as reasonably inferable (e.g. adults, families, young children)"
    },
    "printable_suitability": {
      "type": "string",
      "minLength": 1,
      "description": "How well this style suits home printing for the requested product"
    },
    "do_not_copy": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "element",
          "reason"
        ],
        "properties": {
          "element": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "analysed_at": {
      "type": "string",
      "format": "date-time"
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "reference_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
