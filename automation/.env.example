# Stage 1 creative orchestrator (ADR-023). Variable NAMES only.
# Put the real values in the repo-root .env (git-ignored). These names are kept
# out of the root .env.example on purpose: the ADR-013 guard test forbids
# OpenAI variables there, because the production pipeline must not use an LLM.

# Second Telegram bot from BotFather. Must differ from TELEGRAM_BOT_TOKEN,
# because Telegram allows only one getUpdates poller per token.
AUTOMATION_TELEGRAM_BOT_TOKEN=
# Optional. Default to TELEGRAM_CHAT_ID / TELEGRAM_ALLOWED_USER_IDS.
AUTOMATION_TELEGRAM_CHAT_ID=
AUTOMATION_TELEGRAM_ALLOWED_USER_IDS=
# Only "true" lets the bot reuse TELEGRAM_BOT_TOKEN. Never run another poller on it.
AUTOMATION_ALLOW_SHARED_TOKEN=

OPENAI_API_KEY=
# Required. Text model must support vision input and structured JSON output.
OPENAI_TEXT_MODEL=
# Required. Image generation model.
OPENAI_IMAGE_MODEL=
# Optional. Creative-proof quality; default depends on the model family
# (medium for gpt-image*, standard for dall-e-3).
OPENAI_IMAGE_QUALITY=
# Optional. Concept-preview quality; default is the cheapest documented value
# (low for gpt-image*, standard for dall-e-3).
AUTOMATION_PREVIEW_QUALITY=
# Optional. Concept batches per product including the first (default 3).
# Each batch = 1 text call + 3 preview images.
AUTOMATION_MAX_CONCEPT_BATCHES=
# Optional. Stage 3 AI environment images per marketing run, 0-4 (default 4; 0 = coded environments, no image cost).
AUTOMATION_MARKETING_SCENES=
# Deprecated and ignored: the image size follows each product's orientation
# (see automation/docs/STAGE_1_README.md).
OPENAI_IMAGE_SIZE=

# Optional. USD->GBP rate for "Estimated API cost" (overrides automation/config/openai-pricing.json fx.rate).
AUTOMATION_FX_USD_GBP=

# Optional. Default 6 references per product.
AUTOMATION_MAX_REFERENCES=
