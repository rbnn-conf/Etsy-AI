{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Crochet pattern bundle source (ADR-040): products/<id>/crochet/patterns.json. Owner-approved functional content; Stage 2 formats it and never writes, completes or repairs instructions. Structural shape only: production/src/crochet/bundle.mjs also checks pattern_count, unique identity, defined abbreviations, terminology, assembly and testing evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "format", "title", "theme", "audience", "skill_level", "delivery", "style", "pattern_count", "terminology", "provenance", "patterns"],
  "properties": {
    "schema_version": { "const": 1 },
    "format": { "const": "crochet-pattern-bundle" },
    "title": { "type": "string", "minLength": 1 },
    "theme": { "type": "string", "minLength": 1 },
    "audience": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "skill_level": { "type": "array", "minItems": 1, "items": { "enum": ["beginner", "easy", "intermediate", "experienced"] }, "description": "Craft Yarn Council levels the bundle covers; every pattern's difficulty must be one of them." },
    "delivery": { "type": "array", "minItems": 1, "items": { "enum": ["digital", "printable"] } },
    "style": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "pattern_count": { "type": "integer", "minimum": 1, "description": "Must equal the number of patterns supplied." },
    "terminology": { "enum": ["US", "UK"] },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["author", "origin"],
      "properties": {
        "author": { "type": "string", "minLength": 1, "description": "Who wrote these instructions." },
        "origin": { "enum": ["owner-authored", "commissioned", "licensed", "ai-assisted-draft"], "description": "ai-assisted-draft (ADR-041): model-drafted candidate content; every pattern then states verification_status." },
        "notes": { "type": ["string", "null"] }
      }
    },
    "abbreviations": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 }, "description": "Shared glossary (abbreviation -> meaning) for the Materials + Abbreviations reference." },
    "notes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "combinations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "items"],
      "description": "Optional combination guide (e.g. bouquets) built only from this bundle's patterns.",
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "intro": { "type": ["string", "null"] },
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "patterns"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "patterns": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["pattern_id", "quantity"],
                  "properties": { "pattern_id": { "type": "string", "minLength": 1 }, "quantity": { "type": "integer", "minimum": 1 } }
                }
              },
              "notes": { "type": "array", "items": { "type": "string", "minLength": 1 } }
            }
          }
        }
      }
    },
    "patterns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pattern_id", "name", "category", "difficulty", "finished_size", "yarn", "yarn_weight", "additional_materials", "stitches_used", "abbreviations", "gauge", "instructions", "finishing"],
        "properties": {
          "pattern_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,59}$" },
          "name": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "minLength": 1 },
          "difficulty": { "enum": ["beginner", "easy", "intermediate", "experienced"] },
          "finished_size": { "type": "string", "minLength": 1 },
          "yarn": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["description"],
              "properties": {
                "description": { "type": "string", "minLength": 1 },
                "colour": { "type": ["string", "null"] },
                "amount": { "type": ["string", "null"] }
              }
            }
          },
          "yarn_weight": { "enum": ["0-lace", "1-super-fine", "2-fine", "3-light", "4-medium", "5-bulky", "6-super-bulky", "7-jumbo"] },
          "requires_hook": { "type": "boolean", "description": "Default true. false only for a pattern that uses no hook; hook_size is then optional." },
          "hook_size": {
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["mm"],
            "properties": {
              "mm": { "type": "number", "minimum": 0.5, "maximum": 30 },
              "us": { "type": ["string", "null"] }
            }
          },
          "additional_materials": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "stitches_used": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "abbreviations": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
          "gauge": { "type": "string", "minLength": 1, "description": "The owner's words, including when gauge is not critical." },
          "instructions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["heading", "steps"],
              "properties": {
                "heading": { "type": "string", "minLength": 1 },
                "steps": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["text"],
                    "properties": {
                      "label": { "type": ["string", "null"] },
                      "text": { "type": "string", "minLength": 1 },
                      "stitch_count": { "type": ["integer", "null"], "minimum": 1 }
                    }
                  }
                }
              }
            }
          },
          "assembly_required": { "type": "boolean" },
          "assembly": { "type": "array", "items": { "type": "string", "minLength": 1 }, "description": "Required when more than one piece is made or assembly_required is true." },
          "finishing": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "notes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "origin": { "enum": ["owner-authored", "commissioned", "licensed", "ai-assisted-draft"] },
          "verification_status": { "enum": ["unverified", "tested"], "description": "Required for ai-assisted-draft patterns. tested only with a testing record carrying evidence; owner approval is not verification." },
          "testing": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status"],
            "description": "Absent = not tested. status tested requires tested_by, tested_on and evidence.",
            "properties": {
              "status": { "enum": ["not-tested", "tested"] },
              "tested_by": { "type": "string", "minLength": 1 },
              "tested_on": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
              "evidence": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
