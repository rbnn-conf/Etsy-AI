      "title": "Pie in the Oven",
      "asset": "P005",
      "approved_text": [],
      "production_notes": "There must be exactly one pie inside the oven. Make oven bars and lattice strips bold and widely spaced, avoiding narrow, difficult-to-colour gaps."
    },
