    "pages": {
      "2": {
        "title": "Apple Picking",
        "description": "A broad, low apple tree fills the upper half of the scene. The hedgehog baker stands below with a large handled basket containing six apples, reaching for one more apple on a low branch. Fallen leaves, three apples on the grass and a cottage window in the distance create a simple autumn setting.",
        "source": "approved page brief (page 2)"
      },
      "3": {
        "title": "Mixing the Filling",
        "description": "Central close kitchen-counter scene with the hedgehog stirring a large mixing bowl using a wooden spoon. Four chunky apple slices are visible at the top of the bowl. A cinnamon stick jar, small measuring cup, flour sack and checked tea towel sit around the bowl, with curved cupboards behind.",
        "source": "approved page brief (page 3)"
      },
      "4": {
        "title": "Rolling Pastry",
        "description": "A wide worktable stretches across the page. The hedgehog uses a rolling pin over a large circular pastry sheet, while a small friendly mouse at the side carries one apple in both paws. A pie dish, flour bowl and three leaf-shaped pastry cut-outs form clear supporting details.",
        "source": "approved page brief (page 4)"
      },
      "5": {
        "title": "Pie in the Oven",
        "description": "The open low oven is the focal point, holding one round lattice-topped apple pie on its rack. The hedgehog kneels nearby wearing an oven mitt and peeks in happily. A kitchen clock, hanging oven mitt, kettle and a few large leaves in a jar provide cosy background detail.",
        "source": "approved page brief (page 5)"
      },
      "6": {
        "title": "Cinnamon Bun Swirls",
        "description": "A top-forward counter composition shows a rectangular baking tray with five large spiral cinnamon buns. The hedgehog’s paws place the final bun on the tray. A rolling pin, a small bowl of icing and two loose dough spirals sit nearby, with a simple tiled splashback behind.",
        "source": "approved page brief (page 6)"
      },
      "7": {
        "title": "Cooling Rack Treats",
        "description": "A tall open kitchen window provides the main backdrop. A cooling rack beneath it holds two small apple hand pies and three cinnamon buns. The hedgehog stands beside the rack, holding a tea towel. Outside, a simple tree branch with five large leaves curves into view.",
        "source": "approved page brief (page 7)"
      },
      "8": {
        "title": "Setting the Tea Table",
        "description": "A round table is set for three animal friends. It holds three patterned cups, three plates each with one apple pie slice, and a small vase of large autumn flowers. The hedgehog straightens a napkin while a squirrel and rabbit wait on rounded chairs in the background.",
        "source": "approved page brief (page 8)"
      },
      "9": {
        "title": "Sharing Apple Pie",
        "description": "A warm seated scene centres on the hedgehog, squirrel and rabbit around a small table. Each friend holds a fork above a plate with one pie slice. A whole lattice pie rests on a sideboard behind them, while a window shows a few broad falling leaves.",
        "source": "approved page brief (page 9)"
      },
      "10": {
        "title": "A Cosy Kitchen Goodbye",
        "description": "The hedgehog baker waves from the central kitchen counter, with a gingham cloth and a basket holding one whole pie and four cinnamon buns. The low oven is closed, dishes are neatly stacked, and a crescent moon with two stars appears through the window, ending the story on a peaceful evening note.",
        "source": "approved page brief (page 10)"
      }
    }
  },
