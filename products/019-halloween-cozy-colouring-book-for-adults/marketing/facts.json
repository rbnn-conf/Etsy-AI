    "pages": {
      "2": {
        "title": "The Lantern Bench",
        "description": "A carved pumpkin lantern rests on a worn wooden potting bench, framed by three labelled herb jars, two small seed packets, a watering can, a trowel and a pair of gardening gloves. Above, an arched window shows a full moon, sparse clouds and curling vine silhouettes. Below the bench are three stacked terracotta pots and a basket of fallen leaves.",
        "source": "approved page brief (page 2)"
      },
      "3": {
        "title": "Herbs by Moonlight",
        "description": "Six distinct bundles of garden herbs hang from an ornate iron rail: rosemary, sage, thyme, lavender, mint and chamomile. Each bundle is tied with a ribbon and has recognisable leaf or flower shapes. Behind them, an arched window frames the moon, a garden wall and climbing ivy. A narrow shelf below holds three simple ceramic jars and a small crescent-moon charm.",
        "source": "approved page brief (page 3)"
      },
      "4": {
        "title": "Pumpkin Patch Gate",
        "description": "An open wrought-iron gate stands centrally in a brick-and-stone garden wall. A winding flagstone path leads through the gate to a moonlit pumpkin patch containing seven pumpkins of different sizes. Tall hollyhocks, ivy and curling squash vines frame the gate, while a small lantern hangs from the arch overhead. The full moon sits in open sky beyond.",
        "source": "approved page brief (page 4)"
      },
      "5": {
        "title": "Seed Packet Cabinet",
        "description": "A shallow wooden cabinet with nine square compartments fills the page. The compartments contain: a pumpkin seed packet, a calendula seed packet, a sweet pea seed packet, a rosemary seed packet, a packet of mixed autumn leaves, a small ceramic bird, a spool of twine, a folded garden map and a tiny glass bottle holding acorns. Decorative vines curl lightly around the cabinet corners.",
        "source": "approved page brief (page 5)"
      },
      "6": {
        "title": "Moonflower Trellis",
        "description": "A tall wooden trellis forms the main composition, covered in large open moonflower blooms, heart-shaped leaves and spiralling tendrils. A crescent-shaped hand rake and a small hand fork hang neatly from two hooks. At the base, two terracotta pots, a snail and a cluster of three mushrooms sit among fallen leaves. The upper background remains lightly open with a small moon peeking through leaves.",
        "source": "approved page brief (page 6)"
      },
      "7": {
        "title": "Harvest Tea in the Shed",
        "description": "A round wooden table inside the potting shed holds a floral teapot, two mismatched cups, a plate with four biscuits, a small pumpkin, a sprig-filled vase and an open gardening journal. A checked cloth drapes over one edge. Behind the table, shelves hold jars and pots, while an arched window reveals a moon and garden silhouettes. A stool tucked under the table has a curled sleeping cat beneath it.",
        "source": "approved page brief (page 7)"
      },
      "8": {
        "title": "The Friendly Scarecrow",
        "description": "A smiling scarecrow with a patched hat, buttoned coat and straw hands stands in the centre of a tidy kitchen garden. It holds a small lantern in one hand and a bunch of carrots in the other. Around its feet are five pumpkins, a wheelbarrow of leaves, a low picket fence and curling bean vines. A crescent moon and a few small stars appear in the open upper sky.",
        "source": "approved page brief (page 8)"
      },
      "9": {
        "title": "Garden Ghost's Delivery",
        "description": "A small smiling ghost floats gently beside a potting-shed door, carrying a wicker basket filled with three seed packets and two tiny pumpkins. The ghost wears no costume details beyond a simple scalloped sheet outline. A black cat sits on the doorstep, and a lantern, broom, potted chrysanthemum and climbing ivy decorate the doorway. In the background, a moonlit garden wall and bare branches create",
        "source": "approved page brief (page 9)"
      },
      "10": {
        "title": "Full Moon Garden Finale",
        "description": "A wide view of the enclosed kitchen garden under a large full moon. A central stone birdbath is surrounded by four pumpkin lanterns, mixed autumn flowers and curling squash vines. To the left stands the potting shed with its arched window; to the right, a wrought-iron bench sits beneath an apple tree with five hanging apples. Garden paths, brick walls, potted herbs and distant bats complete the pe",
        "source": "approved page brief (page 10)"
      }
    }
  },
