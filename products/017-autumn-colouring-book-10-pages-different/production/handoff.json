  "pages": [
    {
      "page_number": 1,
      "page_type": "cover",
      "title": "Autumn Railway Journey",
      "asset": "P001",
      "approved_text": [],
      "production_notes": "Cover must contain no title, lettering, badges or creator marks. Keep the locomotive, carriages, viaduct arches, hills and tree canopies as large closed shapes; ensure the full composition remains within landscape safe margins."
    },
    {
      "page_number": 2,
      "page_type": "colouring",
      "title": "Ticket Booth Arrival",
      "asset": "P002",
      "approved_text": [],
      "production_notes": "The two tickets must be visibly plain with no text. Avoid station signs and timetable text. Keep faces simple and ticket, suitcase, booth and locomotive shapes easy to colour."
    },
    {
      "page_number": 3,
      "page_type": "colouring",
      "title": "Luggage Trolley",
      "asset": "P003",
      "approved_text": [],
      "production_notes": "Solvability/check: trolley contains exactly 4 distinct luggage items, with no additional bags elsewhere on the page. Do not add text labels, luggage tags with writing, or busy platform clutter."
    },
    {
      "page_number": 4,
      "page_type": "colouring",
      "title": "Platform Farewell",
      "asset": "P004",
      "approved_text": [],
      "production_notes": "Check that exactly two farewell relatives stand on the platform and that the clock face has no numerals or lettering. Keep the carriage windows large and uncluttered."
    },
    {
      "page_number": 5,
      "page_type": "colouring",
      "title": "Dining Carriage Picnic",
      "asset": "P005",
      "approved_text": [],
      "production_notes": "Check that the table has exactly 3 food items: 1 apple, 1 sandwich triangle, 1 cup. No menu, newspaper, labels or text. Use broad window view and large tableware outlines."
    },
    {
      "page_number": 6,
      "page_type": "colouring",
      "title": "Woodland Tunnel",
      "asset": "P006",
      "approved_text": [],
      "production_notes": "Check for exactly 3 separate steam-cloud shapes and one rabbit. Keep tunnel brick detail sparse and sizeable, without dense masonry texture or tiny leaves."
    },
    {
      "page_number": 7,
      "page_type": "colouring",
      "title": "Signal Box Wave",
      "asset": "P007",
      "approved_text": [],
      "production_notes": "Ensure the semaphore has one clear raised arm and no lettering. Keep the signal box, worker, cat and passing train readable as separate focal elements; use simple field bands rather than dense crops."
    },
    {
      "page_number": 8,
      "page_type": "colouring",
      "title": "Lakeside Stop",
      "asset": "P008",
      "approved_text": [],
      "production_notes": "Solvability/check: exactly 3 ducks on the lake and exactly 1 rowboat. Keep water mostly open for colouring, using only a few broad ripple contours; no additional birds or boats."
    },
    {
      "page_number": 9,
      "page_type": "colouring",
      "title": "Apple Orchard Station",
      "asset": "P009",
      "approved_text": [],
      "production_notes": "Check that the basket contains exactly 5 large distinct apples. There must be exactly 3 apple trees; apples on the trees may be omitted to prevent count confusion. No text on gates, train or platform."
    },
    {
      "page_number": 10,
      "page_type": "colouring",
      "title": "Evening Journey Home",
      "asset": "P010",
      "approved_text": [],
      "production_notes": "Check that exactly 3 travellers wave from windows, exactly 5 stars appear, and exactly 1 fox is present. Use an unfilled moon and stars with no black night sky or shading; keep the scene within safe margins."
    }
  ],
