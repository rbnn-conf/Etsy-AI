    "pages": {
      "2": {
        "title": "Ticket Booth Arrival",
        "description": "A child traveller and an adult stand beside a simple ticket-booth window holding two plain tickets. A friendly station helper leans from the booth, while a small steam locomotive waits in the background beside a platform lamp, suitcase and two rounded autumn trees.",
        "source": "approved page brief (page 2)"
      },
      "3": {
        "title": "Luggage Trolley",
        "description": "A smiling porter pushes a sturdy trolley carrying exactly four clearly separate pieces of luggage: one trunk, one round hatbox, one rectangular suitcase and one small travel bag. A child walks alongside holding a leaf, with the train carriage, platform edge and a few autumn shrubs behind them.",
        "source": "approved page brief (page 3)"
      },
      "4": {
        "title": "Platform Farewell",
        "description": "The vintage steam train pauses at a country platform. A child leans from an open carriage window waving to two relatives on the platform, while another traveller stands at the carriage door with a small bag. A station clock without numbers, a bench, fallen leaves and a low hedge complete the scene.",
        "source": "approved page brief (page 4)"
      },
      "5": {
        "title": "Dining Carriage Picnic",
        "description": "Inside a dining carriage, two child travellers sit at a table looking out of a large window at passing autumn trees. On the table are exactly three simple food items: a round apple, a sandwich triangle and a small cup. A friendly conductor walks down the aisle carrying a plain teapot.",
        "source": "approved page brief (page 5)"
      },
      "6": {
        "title": "Woodland Tunnel",
        "description": "The locomotive emerges from a rounded brick tunnel portal surrounded by tall woodland trees. Large falling leaves swirl above the track, a rabbit watches from a grassy bank, and the train’s puffing steam forms three large cloud shapes in the open sky area.",
        "source": "approved page brief (page 6)"
      },
      "7": {
        "title": "Signal Box Wave",
        "description": "A friendly signal worker waves from the doorway of a small raised signal box as the steam train passes below. Beside the track stands a semaphore signal with its arm angled upward, while a cat sits on the signal-box steps and autumn fields stretch into the distance.",
        "source": "approved page brief (page 7)"
      },
      "8": {
        "title": "Lakeside Stop",
        "description": "The train stops at a tiny lakeside platform while three ducks float on the water. Two travellers stand beside the carriage looking across the lake towards a small rowboat and distant hills. Reeds, a wooden bench and a large maple tree frame the open water.",
        "source": "approved page brief (page 8)"
      },
      "9": {
        "title": "Apple Orchard Station",
        "description": "At a small rural station, a child traveller carries a basket containing exactly five large apples. Behind the platform are three apple trees with simple rounded canopies, while the waiting train and a friendly farmer waving from an orchard gate create a gentle layered scene.",
        "source": "approved page brief (page 9)"
      },
      "10": {
        "title": "Evening Journey Home",
        "description": "The vintage steam train curves through gentle hills towards a small distant station in the evening. Three travellers wave from large carriage windows, while a crescent moon, five simple stars and a line of autumn trees sit above the tracks. A fox watches from the foreground grass.",
        "source": "approved page brief (page 10)"
      }
    }
  },
