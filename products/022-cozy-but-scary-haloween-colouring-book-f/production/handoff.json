  "pages": [
    {
      "page_number": 1,
      "page_type": "cover",
      "title": "Hollowbone Manor Masquerade",
      "asset": "P001",
      "approved_text": [
        "HOLLOWBONE MANOR MASQUERADE"
      ],
      "production_notes": "Verify the title is fully legible and correctly spelled. Keep the cover line-art-only so it can be coloured, while retaining a polished premium cover hierarchy. No barcode or author name required."
    },
    {
      "page_number": 2,
      "page_type": "colouring",
      "title": "The Iron Gate",
      "asset": "P002",
      "approved_text": [],
      "production_notes": "Keep gate scrollwork detailed but with generous enclosed sections. Ensure the approaching figures remain visually separate from the path and manor."
    },
    {
      "page_number": 3,
      "page_type": "colouring",
      "title": "The Maskmaker's Chamber",
      "asset": "P003",
      "approved_text": [],
      "production_notes": "Do not include tiny or illegible shelf labels. Make scissors safe-looking decorative tailoring scissors, not a focal threat."
    },
    {
      "page_number": 4,
      "page_type": "colouring",
      "title": "Velvet Invitation",
      "asset": "P004",
      "approved_text": [],
      "production_notes": "No lengthy text on the invitation. Preserve large colourable sections in the damask fabric, envelope and leaves."
    },
    {
      "page_number": 5,
      "page_type": "colouring",
      "title": "The Grand Stair",
      "asset": "P005",
      "approved_text": [],
      "production_notes": "Separate each costume silhouette clearly. Use repeatable but non-muddy textile patterns and broad stair treads for colouring."
    },
    {
      "page_number": 6,
      "page_type": "colouring",
      "title": "The Candle Corridor",
      "asset": "P006",
      "approved_text": [],
      "production_notes": "Maintain a clear perspective path and avoid dense linework in the far distance. Portrait faces should be varied, stylised and non-graphic."
    },
    {
      "page_number": 7,
      "page_type": "colouring",
      "title": "The Ballroom Waltz",
      "asset": "P007",
      "approved_text": [],
      "production_notes": "Exactly eight dancing figures arranged as four readable pairs. Keep the chandelier ornate but not ink-heavy; preserve the throne as a clear visual clue."
    },
    {
      "page_number": 8,
      "page_type": "colouring",
      "title": "Raven's Toast",
      "asset": "P008",
      "approved_text": [],
      "production_notes": "Ensure there is no implied drinking brand or modern glassware. Give the goblet and greenhouse panes open colourable regions."
    },
    {
      "page_number": 9,
      "page_type": "colouring",
      "title": "Pumpkin Parlour",
      "asset": "P009",
      "approved_text": [],
      "production_notes": "Keep ghost forms tasteful and adult-gothic rather than childish. Do not depict flames as solid black; use outlined stylised fire shapes."
    },
    {
      "page_number": 10,
      "page_type": "colouring",
      "title": "The Moonlit Terrace",
      "asset": "P010",
      "approved_text": [],
      "production_notes": "Use outlined moon and clouds only, with sparse hatching. Keep railing spaces sufficiently broad for comfortable colouring."
    },
    {
      "page_number": 11,
      "page_type": "colouring",
      "title": "The Midnight Supper",
      "asset": "P011",
      "approved_text": [],
      "production_notes": "Avoid food details so small that they become muddy. Keep the feast recognisable and entirely non-gory."
    },
    {
      "page_number": 12,
      "page_type": "colouring",
      "title": "The Clock Strikes Twelve",
      "asset": "P012",
      "approved_text": [],
      "production_notes": "Clock must unambiguously show twelve o'clock: both hands pointing straight up. Verify dial numerals are optional; if used, ensure they are correct and legible."
    },
    {
      "page_number": 13,
      "page_type": "colouring",
      "title": "The Hidden Door",
      "asset": "P013",
      "approved_text": [],
      "production_notes": "Make the secret door's outline obvious and the keyhole centrally readable. Keep curtain folds bold and colourable."
    },
    {
      "page_number": 14,
      "page_type": "colouring",
      "title": "The Portrait Gallery",
      "asset": "P014",
      "approved_text": [],
      "production_notes": "Exactly seven portrait frames, each clearly countable. Keep the emerging figure non-gory and make the mirror reflection decorative rather than visually confusing."
    },
    {
      "page_number": 15,
      "page_type": "colouring",
      "title": "The Conservatory Oracle",
      "asset": "P015",
      "approved_text": [],
      "production_notes": "The crystal ball image should be limited to the simple crown-and-empty-chair symbol, with clear interior lines and no grey fill."
    },
    {
      "page_number": 16,
      "page_type": "colouring",
      "title": "The Costume Wardrobe",
      "asset": "P016",
      "approved_text": [],
      "production_notes": "Avoid tiny repeated garment buttons. The mirror reflection must be anatomically and pose-consistent with the main figure."
    },
    {
      "page_number": 17,
      "page_type": "colouring",
      "title": "The Garden Labyrinth",
      "asset": "P017",
      "approved_text": [],
      "production_notes": "This is scenic, not a maze activity; ensure the path is visually continuous and does not accidentally create impossible crossings. Exactly three guest figures."
    },
    {
      "page_number": 18,
      "page_type": "colouring",
      "title": "The Raven Key",
      "asset": "P018",
      "approved_text": [],
      "production_notes": "Key must be fully visible, unbroken and clearly distinguishable from the raven. Keep feather detail patterned in grouped sections rather than micro-lines."
    },
    {
      "page_number": 19,
      "page_type": "colouring",
      "title": "The Throne Room",
      "asset": "P019",
      "approved_text": [],
      "production_notes": "Exactly eight freestanding candles and two gargoyles. Ensure the mask is prominent, centred and separated from upholstery patterns."
    },
    {
      "page_number": 20,
      "page_type": "colouring",
      "title": "The Crown of Bones",
      "asset": "P020",
      "approved_text": [],
      "production_notes": "Exactly four moths. Keep the crown ornamental rather than grotesque, with clear individual sections for colouring."
    },
    {
      "page_number": 21,
      "page_type": "colouring",
      "title": "The Unmasking",
      "asset": "P021",
      "approved_text": [],
      "production_notes": "Retain an elegant, non-threatening expression through pose. The host, throne and skull mask must remain the primary focal hierarchy."
    },
    {
      "page_number": 22,
      "page_type": "colouring",
      "title": "The Skeleton Orchestra",
      "asset": "P022",
      "approved_text": [],
      "production_notes": "Exactly five musicians and the specified five instruments, all clearly identifiable. Do not use dense real musical notation or readable lyrics."
    },
    {
      "page_number": 23,
      "page_type": "colouring",
      "title": "The Final Procession",
      "asset": "P023",
      "approved_text": [],
      "production_notes": "Exactly six procession figures. Ensure the crown-bearer is visually central, and do not overcrowd the hall with extra character silhouettes."
    },
    {
      "page_number": 24,
      "page_type": "colouring",
      "title": "Dawn at Hollowbone Manor",
      "asset": "P024",
      "approved_text": [],
      "production_notes": "Dawn is conveyed with open linework only, never grey or coloured sky. Keep carriage details readable and avoid obscuring the departing guests."
    },
    {
      "page_number": 25,
      "page_type": "colouring",
      "title": "The Manor Sleeps",
      "asset": "P025",
      "approved_text": [],
      "production_notes": "End without printed text so the final page remains a full colouring design. Keep the skull-mask silhouette small but clearly recognisable; preserve ample white space in the sky and façade."
    }
