  "creative": {
    "note": "Descriptive creative metadata for sales copy only; deliverables and capabilities come from the production facts.",
    "collection": {
      "subject": "Skeleton masqueraders",
      "scene": "Decaying manor ballroom draped in autumn garlands",
      "emotional_tone": "Elegant revelry and unsettling mystery",
      "illustration_style": "Sophisticated monochrome pen-and-ink colouring-book illustration with a gothic storybook sensibility, designed for leisurely adult colouring.",
      "mood": "Cosy, elegant and ominous: candlelit seasonal warmth offset by refined supernatural unease.",
      "detail": "High adult-level detail concentrated in decorative surfaces and architectural ornament, balanced by generous open areas for comfortable colouring; no muddy micro-detail."
    },
    "pages": {
      "2": {
        "title": "The Iron Gate",
        "description": "Tall wrought-iron gates stand open before a weathered Gothic manor. Two elegant skeletal guests in cloaks and feathered masks approach along a cobbled path bordered by pumpkins, curling ivy and bare-branched trees. A crescent moon and small bats appear above distant turrets.",
        "source": "approved page brief (page 2)"
      },
      "5": {
        "title": "The Grand Stair",
        "description": "A sweeping double staircase rises to a landing beneath carved arches. Three skeleton guests descend in different elaborate costumes: a rose-trimmed gown, a cloak with constellation motifs and a high-collared tailcoat. Jack-o'-lanterns, urns of autumn foliage and candle sconces decorate the stairs.",
        "source": "approved page brief (page 5)"
      },
      "8": {
        "title": "Raven's Toast",
        "description": "A sophisticated skeletal guest in a raven-beak mask stands at a small table in a moonlit conservatory, lifting a patterned goblet. A raven perches on the chair back; curling vines, potted chrysanthemums, leaded glass and a tray of pear-shaped treats fill the scene.",
        "source": "approved page brief (page 8)"
      },
      "11": {
        "title": "The Midnight Supper",
        "description": "A long banquet table is set with pumpkins, pomegranates, pears, decorative pies and ornate covered dishes. Empty high-backed chairs line either side, while a single skeletal butler presents a silver cloche at the head of the table. Candelabra and tapestries frame the dining hall.",
        "source": "approved page brief (page 11)"
      },
      "14": {
        "title": "The Portrait Gallery",
        "description": "A richly ornamented gallery contains seven framed ancestor portraits. In each portrait, a different masked skeletal figure poses in period finery; one figure steps partly out of its frame while a living-looking candlelit reflection appears in a gilt mirror opposite.",
        "source": "approved page brief (page 14)"
      },
      "16": {
        "title": "The Costume Wardrobe",
        "description": "Open wardrobe doors reveal neatly hung capes, gowns and tailcoats. A full-length oval mirror reflects a skeleton trying on an antlered mask, while gloves, fans, boots and brooches are arranged on an upholstered stool and dressing table.",
        "source": "approved page brief (page 16)"
      },
      "19": {
        "title": "The Throne Room",
        "description": "Tall doors stand open onto a circular throne room. The empty velvet throne is elevated on a small dais and surrounded by eight tall candles, two stone gargoyle statues and a mosaic floor featuring a skull-and-rose medallion. The jewelled skull mask rests on the throne seat.",
        "source": "approved page brief (page 19)"
      },
      "22": {
        "title": "The Skeleton Orchestra",
        "description": "Five skeleton musicians perform from a carved balcony: violin, cello, flute, harp and hand drum. Music notes are represented only as decorative floating swirls, not printed notation; bats, garlands and small lanterns decorate the balcony rail.",
        "source": "approved page brief (page 22)"
      },
