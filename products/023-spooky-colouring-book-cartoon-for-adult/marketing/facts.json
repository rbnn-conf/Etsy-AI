  "creative": {
    "note": "Descriptive creative metadata for sales copy only; deliverables and capabilities come from the production facts.",
    "collection": {
      "subject": "Monster diners",
      "scene": "All-night roadside diner",
      "emotional_tone": "Cheeky, nostalgic and mischievous",
      "illustration_style": "Bold mid-century horror-cartoon colouring-book line art with a playful retro roadside sensibility.",
      "mood": "Cheeky, nostalgic, mischievous and lightly macabre; humorous spooky escapism for adults.",
      "detail": "Medium detail: large, satisfying colourable shapes supported by selective decorative accents, simple patterns and readable background props; avoid dense micro-detail."
    },
    "pages": {
      "2": {
        "title": "Graveyard Shift",
        "description": "Inside the diner, a bow-tied vampire waiter balances a tray holding a stack of six pancakes, a skull-shaped butter pat and a steaming coffee pot. A bandaged mummy slumps in a booth beneath a window showing a moon and three tiny bats. The table holds a ketchup bottle, salt shaker and folded napkin.",
        "source": "approved page brief (page 2)"
      },
      "4": {
        "title": "Moon Pie Special",
        "description": "A witch in a curled hat flips three crescent-moon pies with a spatula behind the counter. A bubbling cauldron-shaped mixing bowl, flour tin, rolling pin and pie display sit nearby. Four small stars float above the griddle; the menu board has only decorative lines, no small wording.",
        "source": "approved page brief (page 4)"
      },
      "7": {
        "title": "Bottomless Brew",
        "description": "A friendly swamp creature with long arms pours coffee from a giant percolator into three mismatched mugs on a counter. The mugs show a moon, a bat and a skull symbol. A sugar dispenser, three doughnuts and a hanging lamp provide simple framing details.",
        "source": "approved page brief (page 7)"
      },
      "9": {
        "title": "Pie-Eyed Poltergeist",
        "description": "A grinning floating ghost wears a diner bib and faces an enormous pie on a stand. Three pie slices hover around it, moved by ghostly swirls. A startled waiter drops one spoon, while a table tent displays a bold “1” for the contest table.",
        "source": "approved page brief (page 9)"
      },
      "12": {
        "title": "Shake, Rattle and Ghoul",
        "description": "Three distinct ghouls perched on diner stools sip from three extravagant milkshakes: one topped with a cherry eyeball, one with a tiny ghost biscuit, and one with a crescent cookie. A tipped sugar jar spills exactly seven large sugar cubes across the counter. A wall clock reads midnight with both hands pointing to twelve.",
        "source": "approved page brief (page 12)"
      },
      "14": {
        "title": "The Daily Scream",
        "description": "A fluffy werewolf in a booth reads an oversized newspaper with the short masthead “DAILY SCREAM”. On the table are a full moon waffle, a mug and a jam pot. Outside the window, a delivery van shaped like a hearse passes under three rain clouds.",
        "source": "approved page brief (page 14)"
      },
      "16": {
        "title": "Pickle Panic",
        "description": "A mummy chef runs after five lively pickle creatures rolling across the diner kitchen floor. Each pickle has simple eyes and tiny arms. A toppled pickle jar, burger bun, ladle and open swinging kitchen door create a clear action path.",
        "source": "approved page brief (page 16)"
      },
      "19": {
        "title": "Last Call for Creeps",
        "description": "A sleepy zombie waiter flips a large door sign from an open circle to a closed crescent symbol while a witch sweeps and a vampire stacks three stools. Through the front window, the rising sun peeks behind two hills, but the scene stays playful rather than ominous. A single bat yawns from a ceiling beam.",
        "source": "approved page brief (page 19)"
      },
      "21": {
        "title": "See You at Midnight",
        "description": "The diner façade is seen front-on beneath a huge crescent moon, with the main monster cast waving from windows and doorway: vampire, mummy, witch, cyclops, werewolf and ghost. A large haunted milkshake sits on the roof like a sign topper. Six simple stars, two pumpkins and a blank banner provide a celebratory finale.",
        "source": "approved page brief (page 21)"
      }
    }
  },
