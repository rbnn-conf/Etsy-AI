  "creative": {
    "note": "Descriptive creative metadata for sales copy only; deliverables and capabilities come from the production facts.",
    "collection": {
      "subject": "Harvest produce",
      "scene": "Rustic autumn market stall display",
      "emotional_tone": "Abundant, wholesome and celebratory",
      "illustration_style": "Adult colouring-book ink illustration with an harvest-market feel; clean monochrome drawings built from graceful organic contours and decorative botanical styling.",
      "mood": "Calm, abundant, wholesome and quietly celebratory; refined seasonal warmth without spooky, childish or rustic-cliché treatment.",
      "detail": "Moderately detailed, concentrating pattern and texture in selected natural surfaces, foliage and decorative accents while preserving broad open areas for relaxed colouring."
    },
    "pages": {
      "2": {
        "title": "Apple Crate Abundance",
        "description": "A large slatted wooden crate is piled high with 18 clearly distinct apples, with three pears, two small squash and two herb bundles tucked around it. Apple branches and scattered leaves form a restrained decorative frame; woodgrain and leaf veins add colourable texture.",
        "source": "approved page brief (page 2)"
      },
      "3": {
        "title": "Pumpkin and Squash Stall",
        "description": "A three-tier wooden market stand holds eight different pumpkins and squash: ribbed pumpkin, butternut squash, acorn squash, delicata squash, pattypan squash, spaghetti squash, kabocha squash and a small round gourd. Twining vine leaves and blossoms curl lightly around the stand.",
        "source": "approved page brief (page 3)"
      },
      "5": {
        "title": "Herb Market Bundles",
        "description": "Five labelled-looking but blank paper-wrapped herb bundles—rosemary, sage, thyme, parsley and lavender—hang from a simple wooden rail. Small botanical sprigs, seed heads and a terracotta pot sit below; the paper tags are intentionally blank, without printed names.",
        "source": "approved page brief (page 5)"
      },
      "6": {
        "title": "Root Vegetable Barrow",
        "description": "A vintage garden wheelbarrow holds carrots, beetroot, parsnips, turnips and leeks, each with leafy tops. A small hand trowel and gardening gloves rest nearby, while loose leaves and tiny seedheads form a quiet ground-level frame.",
        "source": "approved page brief (page 6)"
      },
      "7": {
        "title": "Late Harvest Table",
        "description": "A rustic table holds a round loaf of bread, a small bowl of apples, a pitcher of dried wheat, a jar of honey with a dipper, two pears, a folded napkin and a cluster of grapes. A lightly patterned table runner anchors the composition, with a narrow leaf garland above.",
        "source": "approved page brief (page 7)"
      },
      "8": {
        "title": "Sunflower Market Bucket",
        "description": "A tall ribbed market bucket holds seven sunflower heads, five small asters and leafy stems. Beside it are three mini pumpkins and a shallow woven tray of seed pods. A few petals and leaves make a gentle oval frame around the composition.",
        "source": "approved page brief (page 8)"
      },
      "10": {
        "title": "Mushroom and Woodland Basket",
        "description": "A low wicker basket contains assorted edible-looking mushrooms with varied caps, chestnuts and a folded linen cloth. Fern fronds, oak leaves, acorns and a few tiny mushrooms create a botanical frame. The scene is naturalistic and decorative, with no creatures, faces or magical elements.",
        "source": "approved page brief (page 10)"
      },
      "11": {
        "title": "Cornucopia of Garden Bounty",
        "description": "A woven cornucopia lies on its side and spills out apples, pears, grapes, corn, carrots, beetroot, leaves and small squash. Tall wheat stems rise behind the horn, while a simple repeating leaf-and-berry border occupies only the lower corners.",
        "source": "approved page brief (page 11)"
      },
      "12": {
        "title": "Harvest Market Stall",
        "description": "A symmetrical open-air market stall with a striped canopy displays produce in six wooden crates: apples, pears, pumpkins, carrots, beetroot and leafy greens. Herb bundles hang at each side, and a simple blank oval sign hangs beneath the canopy. Leaves and wheat sprigs frame the upper corners.",
        "source": "approved page brief (page 12)"
      }
    }
  },
