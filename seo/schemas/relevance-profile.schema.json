{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Relevance profile: the product's own words sorted into facets, used to classify keyword relevance deterministically (ADR-032). A word may belong to one facet only.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "describes", "source", "seasonality", "notes", "central_themes", "formats", "components", "audiences", "attributes", "tangential"],
  "properties": {
    "schema_version": { "const": 1 },
    "profile_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,62}$" },
    "describes": { "type": "object", "required": ["mode", "ref"], "properties": { "mode": { "enum": ["NEW_PRODUCT", "EXISTING_LISTING"] }, "ref": { "type": "string" } } },
    "source": { "type": "string", "minLength": 1, "description": "Where the words came from (idea fields, listing file)" },
    "seasonality": { "enum": ["peak", "in_season", "approaching", "evergreen", "off_season", "unknown", null], "description": "Supplied explicitly; never inferred from the clock. null = not supplied (scored 50, flagged)" },
    "notes": { "type": ["string", "null"] },
    "central_themes": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "The product's subject" },
    "formats": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "What the product is" },
    "components": { "type": "array", "items": { "type": "string" }, "description": "Parts the product contains" },
    "audiences": { "type": "array", "items": { "type": "string" } },
    "attributes": { "type": "array", "items": { "type": "string" }, "description": "Style, use and delivery words" },
    "tangential": { "type": "array", "items": { "type": "string" }, "description": "Mentioned but not central" }
  }
}
