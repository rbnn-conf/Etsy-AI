# Digital Product Factory — environment variable template
#
# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored and must NEVER be committed.
#
# Variable NAMES only. One `.env` in the repository root serves everything.
# This file covers the Etsy integration (services/, Stage 4) and the Telegram
# chat settings. The bot token, OpenAI and Stage 1-3 limits are listed in
# automation/.env.example. Setup guide: DEVELOPER_SETUP.md.

# --- Etsy Open API v3 — API key ---
# Personal/Seller App keystring: the `x-api-key` header and the OAuth 2.0
# `client_id` for the services/ Etsy integration layer.
# ETSY_SHARED_SECRET is the second half of the `x-api-key` pair.
# Consumed by: services/src/etsy (and Stage 4 through it)
ETSY_API_KEYSTRING=
ETSY_SHARED_SECRET=

# --- Etsy Open API v3 — OAuth 2.0 (services/ integration layer) ---
# Required only to run the authenticated (shop) flow. The read-only
# research spike does NOT need these.
#
# ETSY_OAUTH_REDIRECT_URI must EXACTLY match a redirect URI registered on
# the app in Etsy's developer portal (e.g. a localhost URL you paste the
# ?code= back from). Consumed by: services/src/config/env.ts and the
# services/ etsy:* scripts.
ETSY_OAUTH_REDIRECT_URI=https://localhost:8443/etsy/oauth/callback
# Optional. Space/comma-separated OAuth scopes to request.
# Default when unset: "listings_r listings_w".
ETSY_OAUTH_SCOPES=listings_r listings_w
# Optional. Override the API base URL (default https://api.etsy.com/v3).
ETSY_API_BASE_URL=
# Optional. Path to the git-ignored AES-GCM encrypted token envelope.
# Default: services/.secrets/etsy/token.enc.json
ETSY_TOKEN_FILE=
# Encrypted token state and its separate 32-byte key. Keep both persistent in
# deployment secrets/storage; never commit either file.
ETSY_STATE_DIR=
ETSY_TOKEN_KEY_FILE=
ETSY_SHOP_ID=
# Local HTTPS callback listener. Generate a trusted localhost cert with mkcert.
ETSY_TLS_CERT_FILE=
ETSY_TLS_KEY_FILE=
ETSY_CALLBACK_HOST=127.0.0.1
ETSY_CALLBACK_PORT=8443
# Stage 4 (ADR-026) safety switches. Only the exact string "true"/"false" changes a default.
# ETSY_STAGE4_DRY_RUN       default true  — simulated Etsy, zero Etsy requests.
# ETSY_DRAFT_WRITES_ENABLED default false — with dry run off, allows creating real DRAFTS only.
# ETSY_PUBLISH_ENABLED      default false — server gate for publishing; publishing ALSO needs
#                           PUBLISH + CONFIRM PUBLISH in Telegram. Checked again inside the Etsy client.
ETSY_STAGE4_DRY_RUN=
ETSY_DRAFT_WRITES_ENABLED=
ETSY_PUBLISH_ENABLED=
# Seller declarations Etsy requires on every listing (your declaration to Etsy; no default):
# ETSY_SELLER_WHO_MADE  one of i_did | collective | someone_else
# ETSY_SELLER_WHEN_MADE e.g. made_to_order | 2020_2026 (Etsy's current enum)
# ETSY_DIGITAL_QUANTITY optional, 1-999 (default 999)
ETSY_SELLER_WHO_MADE=
ETSY_SELLER_WHEN_MADE=
ETSY_DIGITAL_QUANTITY=
#
# NOT stored here: the access token and refresh token themselves. They
# are encrypted runtime state written to ETSY_TOKEN_FILE by the server-side
# callback. The one-time authorization code, PKCE verifier and state are not
# configuration and are never printed.

# --- Telegram — product review / approval bot (services/) ---
# Notification + APPROVE/REJECT surface for generated products. See
# docs/TELEGRAM_REVIEW.md and ADR-009. Consumed by services/src/telegram/.
# With this left blank or TELEGRAM_NOTIFICATIONS_ENABLED=false the review
# service uses a no-op notifier and nothing in the pipeline changes.
#
# TELEGRAM_BOT_TOKEN is a SECRET (from @BotFather). TELEGRAM_CHAT_ID is the
# one chat the bot posts to and accepts button presses from. The bot uses
# long-poll getUpdates — no webhook, no public endpoint.
TELEGRAM_NOTIFICATIONS_ENABLED=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional. Comma/space-separated Telegram user IDs allowed to APPROVE or
# REJECT. Leave blank to allow any user in TELEGRAM_CHAT_ID (fine for a
# private 1:1 chat).
TELEGRAM_ALLOWED_USER_IDS=

# --- LumiumX design + marketing ---
# There are NO AI/LLM variables. The design and marketing pipeline is fully
# deterministic (ADR-013): DESIGN_SPEC.json / MARKETING_DESIGN_SPEC.json are
# committed configuration, and the marketing engine composes real product
# renders in code. No OpenAI/Anthropic key, no model, no runtime API call.
